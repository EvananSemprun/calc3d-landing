---
/**
 * Pie ÚNICO del sitio (porte de partials/footer.html).
 * `categorias` (opcional) llena `#footerCats` con enlaces a `/tienda/?cat=…`: se pasan
 * en el build desde las páginas que ya tienen las categorías reales (el catálogo). El
 * año se fija al construir.
 */
import isotipo from '../assets/brand/isotipo-amarillo.png';
import logotipo from '../assets/brand/logotipo-blanco.png';

interface Props {
  /** Categorías con productos, para los enlaces del pie. */
  categorias?: { slug: string; nombre: string }[];
}
const { categorias = [] } = Astro.props;

const anio = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/" aria-label="Banano Lab — inicio">
          <img class="brand-logo" src={isotipo.src} alt="" width={38} height={38} />
          <img class="brand-word" src={logotipo.src} alt="Banano Lab" width={logotipo.width} height={logotipo.height} />
        </a>
        <p style="margin-top:18px;max-width:34ch;color:var(--text-dim)">
          Taller de impresión 3D. Materializamos tus ideas, pieza por pieza.
        </p>
      </div>
      <div>
        <h4>Qué hacemos</h4>
        <a href="/impresion-3d/">Impresión 3D</a>
        <a href="/tienda/">Ver catálogo</a>
      </div>
      <div>
        <h4>Catálogo</h4>
        <a href="/tienda/">Ver catálogo</a>
        <div id="footerCats">
          {categorias.map((c) => <a href={`/tienda/?cat=${encodeURIComponent(c.slug)}`}>{c.nombre}</a>)}
        </div>
      </div>
      <div>
        <h4>Contacto</h4>
        <a href="#" data-bl="cotizar">WhatsApp</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {anio} Banano Lab. Todos los derechos reservados.</span>
    </div>
  </div>
</footer>
