---
/**
 * Rellena los CTA de WhatsApp (`[data-bl="cotizar"]`) con el teléfono del negocio.
 *
 * Las páginas son ESTÁTICAS y su build NO depende de la API: el teléfono se pide en el
 * NAVEGADOR (como hacía la tienda vieja). Con la API caída la página sirve igual; solo
 * los CTA de WhatsApp se ocultan, porque un botón que no lleva a ningún lado es peor
 * que no tenerlo. Mientras responde (la API gratuita tarda ~50 s en despertar) quedan
 * visibles con `href="#"`.
 *
 * Se monta una sola vez en `Base`, así cubre también el enlace del pie.
 *
 * ⚠️ Con transiciones de vista hay que REPINTAR en cada navegación: los enlaces nuevos
 * llegan con `href="#"` y un botón de venta muerto es lo peor que puede dejar esta
 * pantalla. El teléfono se pide UNA vez y queda memoizado en el módulo.
 */
---

<script>
  import { fetchInfo } from '../lib/api';

  // Misma regla que el panel y que la tienda vieja: dígitos y "0" inicial -> 58.
  function telefonoInternacional(crudo: string | null): string {
    const digitos = (crudo ?? '').replace(/\D/g, '');
    return digitos.startsWith('0') ? `58${digitos.slice(1)}` : digitos;
  }

  // ⚠️ DOS marcadores, y la diferencia importa: `cotizar` lo INTERCEPTA `PiezaAMedida`
  // para abrir su modal, y `wa-directo` no — es el botón flotante, que tiene que abrir el
  // chat y nada más. Los dos se rellenan con el mismo teléfono desde acá; si se llenara
  // solo uno, el otro quedaría en `href="#"`, que es un botón de venta muerto.
  const enlaces = () =>
    Array.from(
      document.querySelectorAll<HTMLAnchorElement>('a[data-bl="cotizar"], a[data-bl="wa-directo"]'),
    );

  function ocultar() {
    enlaces().forEach((a) => (a.hidden = true));
  }

  // La info del negocio no cambia entre páginas: se pide UNA vez y se reparte. Sin esto,
  // con transiciones de vista el sitio le pegaría a la API en cada clic de navegación.
  // Si la petición falla se borra la memoria para que una navegación posterior pueda
  // reintentar (si no, la API caída un segundo dejaría el botón oculto toda la sesión).
  let infoMemo: ReturnType<typeof fetchInfo> | null = null;
  function info() {
    if (!infoMemo) {
      infoMemo = fetchInfo();
      infoMemo.catch(() => {
        infoMemo = null;
      });
    }
    return infoMemo;
  }

  async function pintar() {
    if (enlaces().length === 0) return;
    try {
      const { whatsappPhone, businessName } = await info();
      const tel = telefonoInternacional(whatsappPhone);
      if (!tel) return ocultar();
      const mensaje = encodeURIComponent(`Hola ${businessName}, quiero cotizar un trabajo.`);
      enlaces().forEach((a) => {
        a.href = `https://wa.me/${tel}?text=${mensaje}`;
        a.target = '_blank';
        a.rel = 'noopener';
        // El botón flotante NACE oculto (ver `BotonWhatsapp.astro`): recién acá se sabe
        // que hay teléfono y que el enlace lleva a algún lado. En los demás no cambia
        // nada, porque nacen visibles.
        a.hidden = false;
      });
    } catch (e) {
      console.warn('Sin datos del negocio (WhatsApp oculto):', e);
      ocultar();
    }
  }

  // Función NOMBRADA, no una arrow anónima: así `addEventListener` deduplica sola si el
  // módulo se evaluara dos veces (una arrow nueva en cada evaluación se apilaría).
  function repintar() {
    void pintar();
  }

  // Los dos momentos, igual que el menú del Header: `astro:page-load` solo existe con el
  // router de `astro:transitions` montado, y sin él el botón se quedaría en `href="#"`.
  repintar();
  document.addEventListener('astro:page-load', repintar);
</script>
