---
/**
 * Hero del inicio (texto actual de la primera slide del carrusel viejo).
 *
 * PLACEHOLDER hasta la Tarea 7: ahí se reemplaza por el carrusel de banners que
 * administra el panel (GET /public/store/banners). Las slides 2 y 3 del carrusel
 * fijo viejo (index.html, "A tu medida" y "Hecho acá") son su respaldo cuando no hay
 * banners: se portan con el carrusel, no acá.
 */
import mascota from '../assets/brand/banano-hola.png';
import LinkButton from './LinkButton.astro';
---

<section class="hero-home" aria-label="Destacados">
  <div class="container hero-art-grid">
    <div>
      <span class="kicker">Impresión 3D</span>
      <h1 class="h1 text-balance">De la idea a la pieza. La imprimimos por vos.</h1>
      <p class="lead">Piezas por encargo en PLA, PETG, ABS y TPU. Desde una unidad.</p>
      <div class="hero-actions">
        <LinkButton href="/tienda/">Ver el catálogo</LinkButton>
      </div>
    </div>
    <img
      class="hero-art"
      src={mascota.src}
      width={mascota.width}
      height={mascota.height}
      alt=""
      loading="eager"
    />
  </div>
</section>
