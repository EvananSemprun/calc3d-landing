---
/** Beneficios reales del taller (nada inventado: sin garantías que no damos). */
interface Beneficio {
  titulo: string;
  texto: string;
}
interface Props {
  beneficios: Beneficio[];
}
const { beneficios } = Astro.props;
---

<!--
  ⚠️ El `h2` no es decorativo: sin él, los tres `h3` de abajo colgaban del `h2` de la
  sección anterior (las vías), y un lector de pantalla los leía como si fueran maneras
  de encargar una pieza. Cada grupo de `h3` necesita su propio `h2`.
-->
<section class="section" aria-labelledby="beneficios-titulo">
  <div class="container">
    <h2 class="h2 mb-6" id="beneficios-titulo">Por qué con nosotros</h2>
    <div class="grid benefits">
      {
        beneficios.map((b) => (
          <div class="benefit">
            <h3>{b.titulo}</h3>
            <p class="dim">{b.texto}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
