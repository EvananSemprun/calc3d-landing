---
/**
 * Hero de la portada. HTML ESTÁTICO (reemplaza al carrusel de 3 slides, que era una isla
 * de React): el `h1`, el subtítulo y las dos acciones quedan en el HTML del build — SEO,
 * sin salto de layout y sin JS para leer el mensaje principal.
 *
 * ⚠️ Un banner del panel reemplaza el ARTE, no los textos. Se usa el primero que tenga
 * imagen (la API los devuelve ordenados por `position`); el título y el subtítulo que el
 * dueño escriba en un banner NO se ven: el mensaje de la portada es uno y es fijo.
 * Sin banners —o si el banner no trae imagen— se usa el arte propio: nunca un hueco.
 *
 * El buscador vive acá adentro: es la primera cosa que alguien hace con mil productos.
 */
import bananoHola from '@/assets/brand/banano-hola.png';
import Buscador from '@/components/catalogo/Buscador';
import LinkButton from '@/components/LinkButton.astro';
import type { Banner } from '@/lib/banner';
import { enlaceBanner } from '@/lib/banner';

interface Props {
  banners?: Banner[];
  /** slug → ruta, armado en el build: `enlaceBanner` resuelve con esto las categorías. */
  rutasDeCategoria?: Record<string, string>;
}

const { banners = [], rutasDeCategoria = {} } = Astro.props;

const banner = banners.find((b) => b.imageUrl) ?? null;
// Un banner sin enlace válido se pinta igual (es arte), solo que no es clicable.
const enlace = banner ? enlaceBanner(banner, rutasDeCategoria) : null;
---

<section class="hero hero-home" aria-label="Banano Lab, impresión 3D a pedido">
  <div class="container hero-art-grid">
    <div>
      <span class="kicker">Impresión 3D</span>
      <h1 class="h1 text-balance">De la idea a la pieza. La imprimimos por vos.</h1>
      <p class="lead">
        Producimos por encargo en nuestro taller, desde una sola unidad. Vos nos decís qué necesitás y nosotros
        resolvemos cómo hacerla.
      </p>
      <div class="hero-actions">
        <LinkButton href="/tienda/">Ver el catálogo</LinkButton>
        <LinkButton href="#" variant="outline" cotizar>Cotizar por WhatsApp</LinkButton>
      </div>
      <div class="hero-search">
        <Buscador client:load />
      </div>
    </div>

    {
      banner && enlace ? (
        <a href={enlace} class="hero-art-link" aria-label={banner.title ? `Ver: ${banner.title}` : 'Ver más'}>
          <img class="hero-art" src={banner.imageUrl} alt="" loading="eager" />
        </a>
      ) : banner ? (
        <img class="hero-art" src={banner.imageUrl} alt="" loading="eager" />
      ) : (
        <img
          class="hero-art"
          src={bananoHola.src}
          width={bananoHola.width}
          height={bananoHola.height}
          alt=""
          loading="eager"
        />
      )
    }
  </div>
</section>
