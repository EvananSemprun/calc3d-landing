---
/**
 * Cabecera ÚNICA del sitio (porte de partials/header.html).
 *
 * Es HTML estático generado en el build, no JS: los enlaces internos son cómo un
 * buscador descubre las otras páginas. El ítem activo se marca acá, al construir
 * (aria-current), ya no en el navegador con blMarcarNav().
 *
 * Pendiente (tareas posteriores): botón del carrito y el enlace "Cotizar a medida"
 * (necesita el WhatsApp del negocio que llega de la API).
 */
import isotipo from '../assets/brand/isotipo-amarillo.png';
import logotipo from '../assets/brand/logotipo-blanco.png';

const ruta = Astro.url.pathname.replace(/\/+$/, '') || '/';

const enlaces = [
  { href: '/', texto: 'Inicio' },
  { href: '/tienda/', texto: 'Catálogo' },
  { href: '/impresion-3d/', texto: 'Impresión 3D' },
];

function activo(href: string): boolean {
  const destino = href.replace(/\/+$/, '') || '/';
  if (destino === '/') return ruta === '/';
  // La ficha de producto cuelga de /producto/, pero pertenece al catálogo.
  if (destino === '/tienda' && ruta.startsWith('/producto')) return true;
  return ruta === destino || ruta.startsWith(destino + '/');
}
---

<div class="topbar">
  <div class="container topbar-inner">
    <span>🍌 Impresión 3D a pedido en Venezuela — coordiná tu pieza por WhatsApp</span>
  </div>
</div>
<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label="Banano Lab — inicio">
      <img class="brand-logo" src={isotipo.src} alt="" width={34} height={34} />
      <img class="brand-word" src={logotipo.src} alt="Banano Lab" width={logotipo.width} height={logotipo.height} />
    </a>
    <nav class="nav-links" id="navLinks" aria-label="Principal">
      {
        enlaces.map((e) => (
          <a href={e.href} aria-current={activo(e.href) ? 'page' : undefined}>
            {e.texto}
          </a>
        ))
      }
    </nav>
    <div class="nav-right">
      <button
        class="nav-toggle"
        type="button"
        aria-label="Menú"
        aria-expanded="false"
        aria-controls="navLinks"
        data-nav-toggle
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Menú móvil: mejora progresiva. Sin JS los enlaces siguen en el HTML.
  const boton = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.getElementById('navLinks');
  boton?.addEventListener('click', () => {
    const abierto = menu?.classList.toggle('open') ?? false;
    boton.setAttribute('aria-expanded', String(abierto));
  });
</script>
