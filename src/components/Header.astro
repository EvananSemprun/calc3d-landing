---
/**
 * Cabecera ÚNICA del sitio (porte de partials/header.html).
 *
 * Es HTML estático generado en el build, no JS: los enlaces internos son cómo un
 * buscador descubre las otras páginas. El ítem activo se marca acá, al construir
 * (aria-current), ya no en el navegador con blMarcarNav().
 *
 * Pendiente (tareas posteriores): botón del carrito y el enlace "Cotizar a medida"
 * (necesita el WhatsApp del negocio que llega de la API).
 */
import isotipo from '../assets/brand/isotipo-amarillo.png';
import logotipo from '../assets/brand/logotipo-blanco.png';
import FranjaEnVivo from './banners/FranjaEnVivo';

/**
 * El texto de la franja lo puede poner un banner de TEXTO desde el panel. Sin ninguno
 * cargado queda el de siempre (decisión del dueño, 2026-11-08): la franja nunca es un
 * hueco. El emoji es parte del diseño y no del dato, así que vive acá.
 */
interface Props {
  texto?: string | null;
}
const { texto } = Astro.props;
const TEXTO_POR_DEFECTO = 'Impresión 3D a pedido en Venezuela — coordina tu pieza por WhatsApp';

const ruta = Astro.url.pathname.replace(/\/+$/, '') || '/';

const enlaces = [
  { href: '/', texto: 'Inicio' },
  { href: '/tienda/', texto: 'Catálogo' },
  { href: '/impresion-3d/', texto: 'Impresión 3D' },
];

function activo(href: string): boolean {
  const destino = href.replace(/\/+$/, '') || '/';
  if (destino === '/') return ruta === '/';
  // La ficha de producto cuelga de /producto/, pero pertenece al catálogo.
  if (destino === '/tienda' && ruta.startsWith('/producto')) return true;
  return ruta === destino || ruta.startsWith(destino + '/');
}
---

<div class="topbar">
  <div class="container topbar-inner">
    <span>🍌 <FranjaEnVivo inicial={texto ?? null} respaldo={TEXTO_POR_DEFECTO} client:load /></span>
  </div>
</div>
<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label="Banano Lab — inicio">
      <img class="brand-logo" src={isotipo.src} alt="" width={34} height={34} />
      <img class="brand-word" src={logotipo.src} alt="Banano Lab" width={logotipo.width} height={logotipo.height} />
    </a>
    <nav class="nav-links" id="navLinks" aria-label="Principal">
      {
        enlaces.map((e) => (
          <a href={e.href} aria-current={activo(e.href) ? 'page' : undefined}>
            {e.texto}
          </a>
        ))
      }
    </nav>
    <div class="nav-right">
      <button class="cart-btn" type="button" data-bl="cart-open" aria-label="Ver tu pedido">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        <span class="cart-count" data-bl="cart-count" hidden>0</span>
      </button>
      <button
        class="nav-toggle"
        type="button"
        aria-label="Menú"
        aria-expanded="false"
        aria-controls="navLinks"
        data-nav-toggle
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Menú móvil: mejora progresiva. Sin JS los enlaces siguen en el HTML.
  //
  // ⚠️ Se cablea TAMBIÉN en `astro:page-load`. Con las transiciones de vista el <body>
  // se reemplaza sin recargar la página: el botón pasa a ser OTRO elemento y un listener
  // enganchado una sola vez queda colgado de uno que ya no está en el DOM — el menú deja
  // de abrir, sin error y sin que nada avise.
  //
  // Se cablea en los DOS momentos a propósito: `astro:page-load` lo dispara el router de
  // `astro:transitions`, así que sin router montado ese evento NO existe y el menú
  // quedaría muerto. Correr también al cargar el módulo lo deja andando con router y sin
  // él (y en la carga inicial cablea antes, sin esperar al evento `load`).
  function cablearMenu() {
    const boton = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const menu = document.getElementById('navLinks');
    if (!boton) return;
    // Seguro contra el doble cableado: dos listeners en el mismo botón se anulan entre
    // sí (toggle dos veces = el menú no abre), que es justo el fallo que esto evita.
    if (boton.dataset.blCableado === '1') return;
    boton.dataset.blCableado = '1';
    boton.addEventListener('click', () => {
      const abierto = menu?.classList.toggle('open') ?? false;
      boton.setAttribute('aria-expanded', String(abierto));
    });
  }

  cablearMenu();
  document.addEventListener('astro:page-load', cablearMenu);
</script>
