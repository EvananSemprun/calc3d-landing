---
/**
 * El banner de una categoría: se ve en la página de esa categoría Y en las fichas de
 * sus productos (decisión del dueño, 2026-11-08).
 *
 * ⚠️ Es ESTÁTICO: imagen y, si el banner tiene destino, un enlace. Sin título encima —
 * la página ya tiene el suyo, y dos encabezados compitiendo en el mismo lugar es ruido.
 * El título viaja igual como `alt`, que es lo único que lo lleva a un lector de pantalla.
 *
 * ⚠️ `bannerDeCategoria` decide cuál es: una sola definición para los dos lugares. Si
 * cada página eligiera por su cuenta, el día que cambie la regla la categoría y la ficha
 * mostrarían banners distintos.
 */
import type { Banner } from '@/lib/banner';
import { enlaceBanner } from '@/lib/banner';

interface Props {
  banner: Banner | null;
  rutasDeCategoria?: Record<string, string>;
}
const { banner, rutasDeCategoria = {} } = Astro.props;
const href = banner ? enlaceBanner(banner, rutasDeCategoria) : null;
---

{
  banner && banner.imageUrl && (
    href ? (
      <a class="banner-cat" href={href} aria-label={banner.title ? `Ver: ${banner.title}` : 'Ver más'}>
        <img src={banner.imageUrl} alt={banner.title ?? ''} loading="lazy" />
      </a>
    ) : (
      <div class="banner-cat">
        <img src={banner.imageUrl} alt={banner.title ?? ''} loading="lazy" />
      </div>
    )
  )
}
