---
/**
 * Layout base de todas las páginas: <head> parametrizable (SEO) + cabecera + pie.
 *
 * Props:
 *  - title        (obligatorio) texto del <title> y de og:title.
 *  - description  (obligatorio) meta description y og:description.
 *  - canonical    ruta ("/tienda/") o URL absoluta. Por defecto, la ruta actual.
 *                 Se vuelve absoluta con `site` (PUBLIC_SITE_URL); sin `site` se omite.
 *  - image        imagen de og:image (ruta o URL absoluta).
 *  - jsonLd       objeto (o arreglo) de datos estructurados schema.org.
 *  - noindex      true para páginas que no deben indexarse.
 *  - categorias   categorías con productos para los enlaces del pie (solo las páginas
 *                 que ya las traen de la API en el build, como el catálogo).
 */
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsappCotizar from '../components/WhatsappCotizar.astro';
import { cargarTienda } from '../lib/tienda-build';
import { textoDeBanner } from '../lib/banner';
import Carrito from '../components/carrito/Carrito';
import PiezaAMedida from '../components/carrito/PiezaAMedida';
import Avisos from '../components/ui/Avisos';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  categorias?: { slug: string; nombre: string }[];
  /** Tipo de Open Graph ("website" por defecto, "product" en las fichas). */
  ogType?: string;
}

const {
  title,
  description,
  canonical,
  image,
  jsonLd,
  noindex = false,
  categorias,
  ogType = 'website',
} = Astro.props;

const absoluta = (ruta: string): string | undefined => {
  if (/^https?:\/\//i.test(ruta)) return ruta;
  return Astro.site ? new URL(ruta, Astro.site).href : undefined;
};

const urlCanonica = absoluta(canonical ?? Astro.url.pathname);
const urlImagen = image ? absoluta(image) : undefined;

// JSON.stringify no escapa "<": un "</script>" dentro de un texto (p.ej. una descripción
// escrita por el dueño) cerraría la etiqueta e inyectaría HTML. La secuencia u003c (con barra invertida) es JSON válido.
const jsonLdSeguro = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;

// `cargarTienda` memoiza por proceso, así que pedirlo acá no cuesta una consulta más:
// es la misma foto del catálogo que ven todas las páginas del build.
const { banners } = await cargarTienda();
const textoDeLaFranja = textoDeBanner(banners);
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {urlCanonica && <link rel="canonical" href={urlCanonica} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#000814" />
    {/* Icono de la pestaña (el isotipo de Banano Lab). Viven en `public/`, que
        Astro copia tal cual a `dist/`. Hasta el 2026-11-07 no había ninguno.

        ⚠️ SON DOS A PROPÓSITO: el isotipo negro es NEGRO PURO (luminancia
        medida 0.0/255) y contra una pestaña en tema oscuro (#202124) da 1.30:1
        de contraste — no se ve. Medido con contraste WCAG el 2026-11-07:
          NEGRO 21.00:1 claro · 1.30:1 oscuro | AMARILLO 1.40:1 · 11.52:1
        Ninguna variante sirve para los dos, así que elige el navegador. Se tomó
        el amarillo (#FFC300) por ser el color de marca.

        El negro va PRIMERO y sin `media`: es el respaldo donde `media` se
        ignora en `rel="icon"`. */}
    <link rel="icon" type="image/png" href="/icono.png" />
    <link
      rel="icon"
      type="image/png"
      href="/icono-oscuro.png"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="apple-touch-icon" href="/icono-oscuro.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:site_name" content="Banano Lab" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {urlCanonica && <meta property="og:url" content={urlCanonica} />}
    {urlImagen && <meta property="og:image" content={urlImagen} />}
    <meta name="twitter:card" content={urlImagen ? 'summary_large_image' : 'summary'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap"
    />

    {jsonLd && <script type="application/ld+json" set:html={jsonLdSeguro} />}

    {/* Transiciones de vista: la navegación entre páginas no recarga, hace un fundido.
        En Astro 7 el componente es `ClientRouter` (se llamaba `ViewTransitions` hasta
        Astro 5).

        ⚠️ Reemplaza el <body> sin recargar, así que todo script que se engancha una vez
        al cargar deja de funcionar tras la primera navegación. Los tres de este sitio
        (menú del Header, CTA de WhatsApp e insignia del carrito) ya se recablean en
        `astro:page-load`; si se agrega otro, tiene que hacer lo mismo.
        El respeto a `prefers-reduced-motion` está en global.css («Guardia de
        movimiento»): Astro solo trae el suyo si alguna página usa `transition:*`. */}
    <ClientRouter />
    <script>
      /**
       * NAVEGACIÓN: el scroll aterriza donde corresponde, y al instante.
       *
       * Dos defectos del MISMO camino de código de `<ClientRouter />`, medidos el
       * 2026-11-07 (los dos los arregla este script, por eso van juntos):
       *
       * 1. ATRÁS perdía la posición de lectura **y la borraba**. El router guarda bien
       *    `{index, scrollX, scrollY}` por entrada de historia, pero la restaura con un
       *    `scrollTo` hecho INMEDIATAMENTE después del swap, cuando la página destino
       *    todavía no recuperó su alto: las islas `client:visible` no hidrataron y las
       *    fotos de R2 no traen dimensiones. Medido con la portada llegando corta a
       *    propósito: un destino de 2600 se recorta a 735. Y el `scrollend` posterior
       *    hace que el router guarde ESE 735 en la entrada: la posición real no se
       *    recuperaba nunca más.
       *
       * 2. Ese `scrollTo(x, y)` va en la forma de DOS ARGUMENTOS (sin `behavior`), así
       *    que `html { scroll-behavior: smooth }` lo convertía en un deslizamiento
       *    animado en cada atrás/adelante que nadie diseñó (medido: 51 pasos en 850 ms).
       *    El único que recibía el comportamiento correcto era quien pide `reduce`,
       *    porque su guardia fuerza `scroll-behavior: auto`.
       *
       * ⚠️⚠️ **EL ATRIBUTO SE REPONE DENTRO DEL SWAP, Y ÉSA ES LA PIEZA QUE NO ES
       * OBVIA.** `swapRootAttributes` de Astro hace `removeAttribute` de **TODOS** los
       * atributos de `<html>` y repone solo los del documento nuevo. El `scrollTo` del
       * router va **después** de eso y **antes** de `astro:after-swap`, así que un
       * `data-bl-navegando` puesto en `astro:before-preparation` llega MUERTO justo al
       * instante que importa: medido en el momento exacto de la llamada daba
       * `navegando: false` y `scroll-behavior: "smooth"`. El único punto entre el swap y
       * el `scrollTo` es `ev.swap` de `astro:before-swap`, que Astro declara `writable`
       * a propósito para envolverlo. Sin eso, lo único que mataba el deslizamiento era
       * el `behavior: 'instant'` del propio reintento 3-8 ms después — y entonces todo
       * colgaba de **una sola pata**: si el usuario movía la rueda ANTES del swap el
       * reintento abandonaba, nadie cancelaba el scroll del router, y volvían los dos
       * defectos juntos (lo arrastra, y lento).
       *
       * La alternativa era sacar `html { scroll-behavior: smooth }` y pedir el
       * deslizamiento explícito en los anclas con hash. Se descartó: obligaría a un
       * listener de clics recableado en `astro:page-load` —justo la clase de fallo
       * silencioso que este repo viene cerrando— para recuperar algo que hoy funciona
       * bien (los anclas internos deslizan y aterrizan exacto). Si el envoltorio de
       * `ev.swap` dejara de funcionar, el síntoma es que vuelve el deslizamiento: visible
       * y medible, no silencioso.
       *
       * El resto del arreglo:
       *  - el destino se CAPTURA en `astro:before-preparation`, antes de que el router
       *    pueda pisarlo; no se vuelve a leer `history.state`.
       *  - después del swap se reintenta llegar mientras el documento crece (ventana de
       *    1 s), siempre con `behavior: 'instant'`. Al aterrizar bien, el `scrollend`
       *    del router guarda la posición BUENA, así que la entrada queda sana.
       *
       * ⚠️ NO SE LE DISCUTE AL USUARIO, y se detecta de DOS formas porque ninguna sola
       * alcanza: por intención (`wheel`/`touchmove`/`keydown`, que avisan incluso cuando
       * el scroll no se mueve — p. ej. rueda hacia abajo estando ya en el tope recortado)
       * y por POSICIÓN (si `scrollY` cambió respecto de lo último que pusimos nosotros y
       * el alto NO cambió, lo movió otro). La segunda es la que no adivina la fuente:
       * arrastrar la barra de scroll, el autoscroll del botón del medio y arrastrar una
       * selección no emiten ninguno de esos tres eventos.
       */
      const VENTANA_MS = 1000;
      const raiz = document.documentElement;

      /** Posición que esta navegación quiere recuperar; null = no hay nada que recuperar. */
      let destino: { x: number; y: number } | null = null;
      let hasta = 0;
      let cuadro = 0;
      let usuarioIntervino = false;
      /** Lo último que pusimos NOSOTROS, con el alto que tenía el documento en ese momento. */
      let puesta: number | null = null;
      let altoDeLaPuesta = 0;

      for (const evento of ['wheel', 'touchmove', 'keydown'] as const) {
        window.addEventListener(
          evento,
          () => {
            usuarioIntervino = true;
          },
          { passive: true },
        );
      }

      /** Las dos marcas que el swap borra y hay que reponer: ver el aviso de arriba. */
      function marcarNavegacion() {
        // Apaga el `smooth` para el `scrollTo` que el router hace enseguida.
        raiz.setAttribute('data-bl-navegando', '');
        // Y apaga la animación `entrada` por el resto de la sesión: `entrada` es una
        // animación DE CARGA y con el router cada clic se volvía una carga, así que el
        // fundido y la entrada corrían encima — la página destino se veía casi vacía
        // durante los 250 ms del fundido (`entrada` la retiene en opacidad 0), el h1 se
        // fundía dos veces y la grilla no se veía hasta 633 ms después del clic; en ATRÁS
        // se re-escenificaba una página ya vista (8 animaciones + el fundido + el scroll).
        // El fundido SE QUEDA: ése es el movimiento que le corresponde a cambiar de
        // página. La regla vive en global.css, al final del bloque de `entrada`.
        raiz.setAttribute('data-bl-navegado', '');
      }

      function anotarPosicion() {
        puesta = window.scrollY;
        altoDeLaPuesta = raiz.scrollHeight;
      }

      /** Se movió alguien que no somos nosotros (y no es el documento creciendo). */
      function seMovioOtro() {
        return (
          puesta !== null &&
          raiz.scrollHeight === altoDeLaPuesta &&
          Math.abs(window.scrollY - puesta) > 1
        );
      }

      function terminar() {
        if (cuadro) cancelAnimationFrame(cuadro);
        cuadro = 0;
        destino = null;
        puesta = null;
        raiz.removeAttribute('data-bl-navegando');
      }

      function intentar() {
        if (cuadro) cancelAnimationFrame(cuadro);
        cuadro = 0;
        if (!destino) return;
        if (usuarioIntervino || seMovioOtro()) return terminar();
        // Lo máximo que se puede pedir con el alto de AHORA: el resto llega cuando el
        // documento crezca, y para eso está el reintento.
        const objetivo = Math.min(destino.y, Math.max(0, raiz.scrollHeight - window.innerHeight));
        if (Math.abs(window.scrollY - objetivo) > 1) {
          window.scrollTo({ left: destino.x, top: objetivo, behavior: 'instant' });
        }
        anotarPosicion();
        if (Math.abs(window.scrollY - destino.y) <= 1 || Date.now() >= hasta) return terminar();
        cuadro = requestAnimationFrame(intentar);
      }

      document.addEventListener('astro:before-preparation', (ev) => {
        usuarioIntervino = false;
        // En una navegación de historia el navegador YA aplicó la entrada destino, así
        // que acá `history.state` trae su posición guardada, intacta.
        const estado: { scrollX?: number; scrollY?: number } | null = history.state;
        destino =
          ev.navigationType === 'traverse' && estado && typeof estado.scrollY === 'number'
            ? { x: estado.scrollX ?? 0, y: estado.scrollY }
            : null;
      });

      // El ÚNICO punto entre `swapRootAttributes` (que borra los atributos de <html>) y
      // el `scrollTo` del router. `ev.swap` es el punto de extensión de Astro para esto.
      document.addEventListener('astro:before-swap', (ev) => {
        const swapDelRouter = ev.swap;
        ev.swap = () => {
          swapDelRouter();
          marcarNavegacion();
        };
      });

      document.addEventListener('astro:after-swap', () => {
        // Acá el router ya hizo su `scrollTo`, recortado si la página aún no creció.
        hasta = Date.now() + VENTANA_MS;
        anotarPosicion(); // la posición en la que el router nos dejó
        if (!destino) terminar();
        else intentar();
      });

      // Las islas y las fotos llegan después del swap: éste es el momento en que el alto
      // ya suele ser el definitivo.
      document.addEventListener('astro:page-load', () => {
        if (destino) intentar();
        else raiz.removeAttribute('data-bl-navegando');
      });
    </script>
    <slot name="head" />
  </head>
  <body>
    <Header texto={textoDeLaFranja} />
    <main>
      <slot />
    </main>
    <Footer categorias={categorias} />
    <WhatsappCotizar />
    <Carrito client:load />
    <PiezaAMedida client:idle />
    {/* Avisos flotantes (sonner). Isla GLOBAL y OBLIGATORIA: sin ella cada
        `toast()` del sitio no pinta nada y falla en silencio. */}
    <Avisos client:idle />
  </body>
</html>
