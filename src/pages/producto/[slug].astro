---
/**
 * Ficha de producto, una página estática por producto (SSG). `getStaticPaths` trae
 * el catálogo en el build y, por cada slug, la ficha completa (opciones, fotos,
 * descripción). El contenido queda en el HTML (SEO) y la isla `Ficha` lo hidrata.
 */
import Base from '../../layouts/Base.astro';
import FichaEnVivo from '../../components/ficha/FichaEnVivo';
import Ficha from '../../components/ficha/Ficha';
import RelacionadosEnVivo from '../../components/ficha/RelacionadosEnVivo';
import { cargarTienda } from '../../lib/tienda-build';
import BannerCategoriaEnVivo from '../../components/banners/BannerCategoriaEnVivo';
import { bannerDeCategoria } from '../../lib/banner';
import { jsonLdDeProducto } from '../../lib/ficha';
import { rutaDeSlug } from '../../lib/paginacion';
import { relacionadosDe } from '../../lib/relacionados';
import { rutaFicha, type ProductoVitrina } from '../../lib/producto';
import type { InfoApi } from '../../lib/api';
import type { Categoria } from '../../lib/catalogo';

export async function getStaticPaths() {
  // Todo sale de la MISMA carga que el resto del sitio (`cargarTienda`): una petición con
  // las fichas completas (antes: una por producto, que con ~1.000 topaba el límite público)
  // y, sobre todo, el mismo pie y las mismas categorías que las demás páginas aunque el
  // dueño edite una categoría a mitad del build.
  const { completos: lista, info, categorias, raices } = await cargarTienda();

  // La elección sale de `relacionadosDe`, la MISMA función que usa la isla al
  // refrescar: con la regla escrita acá a mano, el sitio ofrecía una cosa recién
  // construido y otra un minuto después.
  return lista.map((producto) => ({
    params: { slug: producto.id },
    props: { producto, info, relacionados: relacionadosDe(lista, producto), categorias, raices },
  }));
}

interface Props {
  producto: ProductoVitrina;
  info: InfoApi;
  relacionados: ProductoVitrina[];
  categorias: Categoria[];
  raices: { slug: string; nombre: string }[];
}

const { producto: p, info, relacionados, categorias, raices } = Astro.props as Props;

// Memoizado: no cuesta una consulta mas.
const { banners } = await cargarTienda();

const descripcion = p.desc || p.description || `${p.name} — impresión 3D a pedido.`;
// Con barra final, para que coincida con la URL servida (/producto/slug/) y el sitemap.
const canonical = rutaFicha(p.id);
const imagen = p.image?.url;

const jsonLd = jsonLdDeProducto(p, {
  descripcion,
  imagen,
  url: Astro.site ? new URL(canonical, Astro.site).href : undefined,
});
---

<Base
  title={`${p.name} — ${info.businessName}`}
  description={descripcion}
  canonical={canonical}
  image={imagen}
  ogType="product"
  jsonLd={jsonLd}
  categorias={raices}
>
  <meta slot="head" property="product:price:amount" content={p.price.toFixed(2)} />
  <meta slot="head" property="product:price:currency" content="USD" />

  <div class="container">
    <nav class="crumbs" aria-label="Ruta">
      <a href="/tienda/">Tienda</a><span>/</span>
      {p.catLabel && (
        <>
          <a href={rutaDeSlug(p.cat, categorias)}>{p.catLabel}</a><span>/</span>
        </>
      )}
      <span class="dim">{p.name}</span>
    </nav>
  </div>

  <main class="container">
    <BannerCategoriaEnVivo inicial={bannerDeCategoria(banners, p.cat)} slug={p.cat} client:load />
    <FichaEnVivo inicial={p} slug={p.id} info={info} client:load />
  </main>

  <RelacionadosEnVivo
    inicial={relacionados}
    actual={{ id: p.id, cat: p.cat }}
    tasa={info.rate}
    client:visible
  />
</Base>
