---
/** `/tienda/<categoria>/<subcategoria>/`: la página 1 de una subcategoría. */
import ListadoCategoria from '../../../../components/catalogo/ListadoCategoria.astro';
import { rutasDeListado } from '../../../../lib/tienda-build';

export const getStaticPaths = () => rutasDeListado({ subcategoria: true, paginas: false });

const { listado, info, raices } = Astro.props;
---

<ListadoCategoria listado={listado} pagina={1} info={info} raices={raices} />
