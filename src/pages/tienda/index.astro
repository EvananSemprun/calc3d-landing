---
/**
 * Índice de la tienda (`/tienda/`): las categorías y unos destacados. Ya NO lista el
 * catálogo entero (con mil productos eran 4,4 MB en una sola página): cada categoría
 * tiene sus páginas en `/tienda/<categoria>/`.
 *
 * Si la API falla durante el build, el build FALLA a propósito (sin try/catch): publicar
 * un catálogo vacío en silencio sería peor que no publicar.
 */
import Base from '../../layouts/Base.astro';
import CtaCotizar from '../../components/CtaCotizar.astro';
import TarjetaProducto from '../../components/catalogo/TarjetaProducto';
import { cargarTienda } from '../../lib/tienda-build';
import { rutaDeCategoria } from '../../lib/paginacion';
import { destacadosDe, TOPE_DESTACADOS_TIENDA } from '../../lib/portada';

const { productos, info, listados, raices, categoriasDelIndice } = await cargarTienda();
// Mismo criterio que la portada (la insignia del panel manda) con otro tope: ver `portada.ts`.
const destacados = destacadosDe(productos, TOPE_DESTACADOS_TIENDA);
const hijasDe = (slug: string) => listados.find((l) => l.cat === slug && l.sub === null)?.hijas ?? [];
---

<Base
  title={`Catálogo — ${info.businessName}`}
  description="Llaveros, identificadores, soportes, decoración y regalos personalizados, fabricados en impresión 3D en nuestro taller."
  canonical="/tienda/"
  categorias={raices}
>
  <section class="shop-head">
    <div class="container">
      <span class="kicker">Catálogo · Impresión 3D</span>
      <h1 class="h1 text-balance">Productos personalizados, hechos a pedido.</h1>
      <p class="lead">
        Llaveros, identificadores, soportes, decoración y regalos. Todo personalizable, fabricado en nuestro taller.
      </p>
    </div>
  </section>

  {
    categoriasDelIndice.length > 0 && (
      <section class="section" style="padding-top:0">
        <div class="container">
          <h2 class="h2" style="margin-bottom:24px">Categorías</h2>
          <ul class="grid shop-grid" style="list-style:none;padding:0;margin:0">
            {categoriasDelIndice.map((c) => (
              <li>
                <a class="card block p-6 hover:border-primary" href={rutaDeCategoria(c.slug)}>
                  <h3 class="text-lg font-semibold">{c.nombre}</h3>
                  <p class="mono dim mt-1 text-sm">
                    {c.n} producto{c.n === 1 ? '' : 's'}
                  </p>
                  {hijasDe(c.slug).length > 0 && (
                    <p class="dim mt-2 text-sm">{hijasDe(c.slug).map((h) => h.nombre).join(' · ')}</p>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    destacados.length > 0 && (
      <section class="section" style="padding-top:0">
        <div class="container">
          <h2 class="h2" style="margin-bottom:24px">Destacados</h2>
          <div class="grid shop-grid">
            {destacados.map((p) => (
              <TarjetaProducto producto={p} tasa={info.rate} client:visible />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    productos.length === 0 && (
      <section class="section" style="padding-top:0">
        <div class="container shop-state">
          <strong>Todavía no hay productos publicados.</strong>
          <p class="dim">Estamos preparando el catálogo. Mientras tanto, escribinos y cotizamos tu pieza.</p>
        </div>
      </section>
    )
  }

  <CtaCotizar
    titulo="¿No encontrás lo que buscás?"
    texto="Fabricamos cualquier pieza a tu medida. Escribinos y te cotizamos."
    boton="Cotizar pieza personalizada"
  />
</Base>
