---
/**
 * Inicio. Un hero fijo, las CATEGORÍAS como puertas al catálogo y UNA franja de
 * destacados: con mil productos, repetir cuatro tarjetas por cada categoría era elegir
 * por azar lo que se ve (y costaba 124 islas de React). El carrusel de 3 slides murió
 * con esto: su mensaje quedó en el hero y en `Vias.astro`.
 *
 * Todo lo que se puede escribir en HTML está en HTML (SEO + peso): hero, categorías,
 * vías del servicio, beneficios, proceso y FAQ. Las únicas islas son el buscador (dentro
 * del hero), la Flash Sale y las tarjetas de los destacados.
 *
 * El build necesita la API arriba (categorías, productos, info); los BANNERS son la
 * excepción: si fallan, el hero usa su arte propio (ver `cargarTienda`).
 *
 * NO hay contadores inventados, reseñas ni portafolio: solo lo que es verdad.
 */
import Base from '../layouts/Base.astro';
import HeroEnVivo from '../components/inicio/HeroEnVivo';
import bananoHola from '../assets/brand/banano-hola.png';
import { bannersDeHero } from '../lib/banner';
import Vias from '../components/inicio/Vias.astro';
import FlashSale from '../components/inicio/FlashSale';
import CategoriasEnVivo from '../components/catalogo/CategoriasEnVivo';
import DestacadosEnVivo from '../components/catalogo/DestacadosEnVivo';
import TarjetaProducto from '../components/catalogo/TarjetaProducto';
import Beneficios from '../components/Beneficios.astro';
import Pasos from '../components/Pasos.astro';
import Faq from '../components/Faq.astro';
import CtaCotizar from '../components/CtaCotizar.astro';
import { cargarTienda } from '../lib/tienda-build';
import { rutaDeCategoria, rutasDeListados } from '../lib/paginacion';
import { destacadosDe, TOPE_DESTACADOS } from '../lib/portada';

const { completos, info, listados, raices, banners } = await cargarTienda();
const slidesDelHero = bannersDeHero(banners);
const rutasDeCategoria = rutasDeListados(listados);

// `raices` ya son las categorías raíz con productos ("Sin categoría" afuera): es lo
// mismo que lleva el pie de todas las páginas, así que no se recalcula acá.
const destacados = destacadosDe(completos, TOPE_DESTACADOS);

const beneficios = [
  { titulo: 'Hecho a pedido', texto: 'Producimos cuando encargás: sin stock viejo ni sobreproducción.' },
  { titulo: 'Atención por WhatsApp', texto: 'Coordinás directo con el taller, sin formularios eternos.' },
  { titulo: 'Pagás al coordinar', texto: 'En dólares o en bolívares a la tasa del día, como prefieras.' },
];

const pasos = [
  { titulo: 'Nos contás', texto: 'Por WhatsApp o desde acá. Medidas, cantidad, para cuándo — lo que tengas.' },
  { titulo: 'Cotizamos', texto: 'Precio cerrado antes de empezar. Sin sorpresas a mitad del trabajo.' },
  { titulo: 'Producimos', texto: 'Arranca la impresora con el alcance ya acordado.' },
  { titulo: 'Revisás', texto: 'Te mostramos avances. Si algo no va, se corrige antes de terminar.' },
  { titulo: 'Entregamos', texto: 'Coordinamos entrega y pago por WhatsApp, como prefieras.' },
];

const preguntas = [
  {
    pregunta: '¿Cuánto tarda un pedido?',
    respuesta:
      'Depende de la pieza y la cantidad. Cada producto del catálogo dice sus días de producción; para algo a medida te lo confirmamos al cotizar.',
  },
  {
    pregunta: '¿Puedo mandar mi propio archivo?',
    respuesta:
      'Sí. Si tenés el modelo en STL, 3MF o STEP, lo imprimimos. Si no lo tenés, lo diseñamos nosotros y se cotiza aparte.',
  },
  {
    pregunta: '¿Cómo se paga?',
    respuesta: 'Se coordina por WhatsApp. Trabajamos en dólares y también en bolívares a la tasa del día.',
  },
  {
    pregunta: '¿Hay cantidad mínima?',
    respuesta:
      'Algunos productos sí, y está indicado en su ficha. Para trabajos a medida no hay mínimo fijo: se cotiza según el caso.',
  },
];
---

<Base
  title="Banano Lab — Impresión 3D a pedido en Venezuela"
  description="Taller de impresión 3D en Venezuela. Imprimimos piezas por encargo, desde una unidad. Cotizá por WhatsApp."
  canonical="/"
  categorias={raices}
>
  <HeroEnVivo slidesIniciales={slidesDelHero} rutasDeCategoria={rutasDeCategoria} arte={{ src: bananoHola.src, width: bananoHola.width, height: bananoHola.height }} client:load />

  <CategoriasEnVivo inicial={raices} modo="raices" titulo="Mirá por categoría" verTodo client:load />

  <DestacadosEnVivo inicial={destacados} tope={TOPE_DESTACADOS} tasa={info.rate} verTodo client:load />

  <FlashSale tasa={info.rate} client:visible />

  <Vias />

  <Beneficios beneficios={beneficios} />

  <section id="como-trabajamos" class="section section--blue">
    <div class="container">
      <h2 class="h2 text-balance mb-2">Cómo trabajamos</h2>
      <p class="lead max-w-[52ch]">
        Primero entendemos qué necesitás, después ponemos precio. Lo mismo para una pieza suelta que para una tanda.
      </p>
      <Pasos pasos={pasos} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="h2 mb-6">Preguntas frecuentes</h2>
      <Faq preguntas={preguntas} />
    </div>
  </section>

  <CtaCotizar
    titulo="¿Tenés una idea? La convertimos en producto."
    texto="Contanos qué necesitás y te respondemos con un precio."
    boton="Cotizar ahora"
  />
</Base>
