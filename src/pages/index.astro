---
/**
 * Inicio. Un hero fijo, la COLECCIÓN del panel (si hay una vigente), las CATEGORÍAS como
 * puertas al catálogo y UNA franja de destacados: con mil productos, repetir cuatro tarjetas por cada categoría era elegir
 * por azar lo que se ve (y costaba 124 islas de React). El carrusel de 3 slides murió
 * con esto: su mensaje quedó en el hero y en `Vias.astro`.
 *
 * Todo lo que se puede escribir en HTML está en HTML (SEO + peso): hero, categorías,
 * vías del servicio, beneficios, proceso y FAQ. Las únicas islas son el buscador (dentro
 * del hero), la Flash Sale y las tarjetas de los destacados.
 *
 * El build necesita la API arriba (categorías, productos, info); los BANNERS son la
 * excepción: si fallan, el hero usa su arte propio (ver `cargarTienda`).
 *
 * NO hay contadores inventados, reseñas ni portafolio: solo lo que es verdad.
 */
import Base from '../layouts/Base.astro';
import HeroEnVivo from '../components/inicio/HeroEnVivo';
import bananoHola from '../assets/brand/banano-hola.png';
import { bannersDeHero } from '../lib/banner';
import Vias from '../components/inicio/Vias.astro';
import FlashSale from '../components/inicio/FlashSale';
import CategoriasEnVivo from '../components/catalogo/CategoriasEnVivo';
import ColeccionEnVivo from '../components/catalogo/ColeccionEnVivo';
import DestacadosEnVivo from '../components/catalogo/DestacadosEnVivo';
import TarjetaProducto from '../components/catalogo/TarjetaProducto';
import Beneficios from '../components/Beneficios.astro';
import Pasos from '../components/Pasos.astro';
import Faq from '../components/Faq.astro';
import CtaCotizar from '../components/CtaCotizar.astro';
import { cargarTienda } from '../lib/tienda-build';
import { rutaDeCategoria, rutasDeListados } from '../lib/paginacion';
import { destacadosDe, franjaDePortada, TOPE_DESTACADOS } from '../lib/portada';

const { completos, info, listados, raices, banners, coleccion } = await cargarTienda();
const slidesDelHero = bannersDeHero(banners);
const rutasDeCategoria = rutasDeListados(listados);

// `raices` ya son las categorías raíz con productos ("Sin categoría" afuera): es lo
// mismo que lleva el pie de todas las páginas, así que no se recalcula acá.
// La colección que el dueño eligió en el panel va HORNEADA (HTML para quien entra sin JS y para
// el buscador) y `ColeccionEnVivo` la refresca al montar. Sin colección vigente, null: no se
// dibuja nada bajo el hero. «Destacados» es otra franja, siempre presente, más abajo.
const franjaInicial = franjaDePortada(coleccion, TOPE_DESTACADOS);
const destacados = destacadosDe(completos, TOPE_DESTACADOS);

const beneficios = [
  { titulo: 'Hecho a pedido', texto: 'Producimos cuando encargas. Sin stock viejo.' },
  { titulo: 'Atención por WhatsApp', texto: 'Hablas directo con el taller.' },
  { titulo: 'Pagas al coordinar', texto: 'En dólares o en bolívares, a la tasa del día.' },
];

const pasos = [
  { titulo: 'Nos cuentas', texto: 'Medidas, cantidad y para cuándo.' },
  { titulo: 'Cotizamos', texto: 'Precio cerrado antes de empezar.' },
  { titulo: 'Producimos', texto: 'Arranca la impresora.' },
  { titulo: 'Revisas', texto: 'Te mostramos avances y se corrige a tiempo.' },
  { titulo: 'Entregamos', texto: 'Entrega y pago por WhatsApp.' },
];

const preguntas = [
  {
    pregunta: '¿Cuánto tarda un pedido?',
    respuesta:
      'Cada producto dice sus días en su ficha. Para algo a medida, te lo confirmamos al cotizar.',
  },
  {
    pregunta: '¿Puedo mandar mi propio archivo?',
    respuesta:
      'Sí: STL, 3MF o STEP. Si no lo tienes, lo diseñamos nosotros y se cotiza aparte.',
  },
  {
    pregunta: '¿Cómo se paga?',
    respuesta: 'Por WhatsApp, en dólares o en bolívares a la tasa del día.',
  },
  {
    pregunta: '¿Hay cantidad mínima?',
    respuesta:
      'Algunos productos sí, y lo dice su ficha. A medida no hay mínimo fijo.',
  },
];
---

<Base
  title="Banano Lab — Impresión 3D a pedido en Venezuela"
  description="Taller de impresión 3D en Venezuela. Imprimimos piezas por encargo, desde una unidad. Cotiza por WhatsApp."
  canonical="/"
  categorias={raices}
>
  <HeroEnVivo slidesIniciales={slidesDelHero} rutasDeCategoria={rutasDeCategoria} arte={{ src: bananoHola.src, width: bananoHola.width, height: bananoHola.height }} client:load />

  <ColeccionEnVivo inicial={franjaInicial} tope={TOPE_DESTACADOS} tasa={info.rate} client:load />

  <CategoriasEnVivo inicial={raices} modo="raices" titulo="Mira por categoría" verTodo client:load />

  <DestacadosEnVivo inicial={destacados} tope={TOPE_DESTACADOS} tasa={info.rate} fila verTodo client:load />

  <FlashSale tasa={info.rate} client:visible />

  <Vias />

  <Beneficios beneficios={beneficios} />

  <section id="como-trabajamos" class="section section--blue">
    <div class="container">
      <h2 class="h2 text-balance mb-2">Cómo trabajamos</h2>
      <p class="lead max-w-[52ch]">
        Primero entendemos qué necesitas, después ponemos precio.
      </p>
      <Pasos pasos={pasos} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="h2 mb-6">Preguntas frecuentes</h2>
      <Faq preguntas={preguntas} />
    </div>
  </section>

  <CtaCotizar
    titulo="¿Tienes una idea? La convertimos en producto."
    texto="Cuéntanos qué necesitas y te respondemos con un precio."
    boton="Cotizar ahora"
  />
</Base>
