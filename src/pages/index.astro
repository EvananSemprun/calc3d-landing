---
/**
 * Inicio. El texto fijo (hero fallback, beneficios, proceso, FAQ) está en el HTML del
 * build (SEO). Los DESTACADOS y los bloques por categoría se traen de la API EN EL BUILD
 * y quedan como HTML estático (SEO + enlaces internos al catálogo): por eso el build del
 * inicio ahora SÍ necesita la API arriba (igual que el catálogo). El carrusel y la Flash
 * Sale son islas que se enriquecen en el navegador (banners/oferta que administra el panel).
 *
 * NO hay contadores inventados, reseñas ni portafolio: solo lo que es verdad.
 */
import Base from '../layouts/Base.astro';
import Carrusel from '../components/inicio/Carrusel';
import FlashSale from '../components/inicio/FlashSale';
import TarjetaProducto from '../components/catalogo/TarjetaProducto';
import Beneficios from '../components/Beneficios.astro';
import Pasos from '../components/Pasos.astro';
import Faq from '../components/Faq.astro';
import CtaCotizar from '../components/CtaCotizar.astro';
import { fetchProductos, fetchCategorias, fetchInfo } from '../lib/api';

const [productos, categorias, info] = await Promise.all([
  fetchProductos(),
  fetchCategorias(),
  fetchInfo(),
]);

const destacados = productos.slice(0, 4);
const bloques = categorias
  .map((c) => ({ ...c, items: productos.filter((p) => p.cat === c.slug).slice(0, 4) }))
  .filter((c) => c.items.length > 0);

const beneficios = [
  { titulo: 'Hecho a pedido', texto: 'Producimos cuando encargás: sin stock viejo ni sobreproducción.' },
  { titulo: 'Atención por WhatsApp', texto: 'Coordinás directo con el taller, sin formularios eternos.' },
  { titulo: 'Listo en N días', texto: 'Cada ficha dice sus días de producción. Sin promesas vagas.' },
  { titulo: 'Pagás al coordinar', texto: 'En dólares o en bolívares a la tasa del día, como prefieras.' },
];

const pasos = [
  { titulo: 'Nos contás', texto: 'Por WhatsApp o desde acá. Medidas, cantidad, para cuándo — lo que tengas.' },
  { titulo: 'Cotizamos', texto: 'Precio cerrado antes de empezar. Sin sorpresas a mitad del trabajo.' },
  { titulo: 'Producimos', texto: 'Arranca la impresora con el alcance ya acordado.' },
  { titulo: 'Revisás', texto: 'Te mostramos avances. Si algo no va, se corrige antes de terminar.' },
  { titulo: 'Entregamos', texto: 'Coordinamos entrega y pago por WhatsApp, como prefieras.' },
];

const preguntas = [
  {
    pregunta: '¿Cuánto tarda un pedido?',
    respuesta:
      'Depende de la pieza y la cantidad. Cada producto del catálogo dice sus días de producción; para algo a medida te lo confirmamos al cotizar.',
  },
  {
    pregunta: '¿Puedo mandar mi propio archivo?',
    respuesta:
      'Sí. Si tenés el modelo en STL, 3MF o STEP, lo imprimimos. Si no lo tenés, lo diseñamos nosotros y se cotiza aparte.',
  },
  {
    pregunta: '¿Cómo se paga?',
    respuesta: 'Se coordina por WhatsApp. Trabajamos en dólares y también en bolívares a la tasa del día.',
  },
  {
    pregunta: '¿Hay cantidad mínima?',
    respuesta:
      'Algunos productos sí, y está indicado en su ficha. Para trabajos a medida no hay mínimo fijo: se cotiza según el caso.',
  },
];
---

<Base
  title="Banano Lab — Impresión 3D a pedido en Venezuela"
  description="Taller de impresión 3D en Venezuela. Imprimimos piezas por encargo en PLA, PETG, ABS y TPU, desde una unidad. Cotizá por WhatsApp."
  canonical="/"
>
  <Carrusel client:load />

  <FlashSale tasa={info.rate} client:visible />

  {
    destacados.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="eyebrow-row">
            <h2 class="h2">Del catálogo</h2>
            <a href="/tienda/" class="text-sm font-semibold text-primary hover:underline">
              Ver todo →
            </a>
          </div>
          <div class="grid shop-grid">
            {destacados.map((p) => (
              <TarjetaProducto producto={p} tasa={info.rate} client:visible />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    bloques.map((c) => (
      <section class="section cat-block">
        <div class="container">
          <div class="eyebrow-row">
            <h2 class="h2">{c.nombre}</h2>
            <a
              href={`/tienda/?cat=${encodeURIComponent(c.slug)}`}
              class="text-sm font-semibold text-primary hover:underline"
            >
              Ver todo →
            </a>
          </div>
          <div class="grid shop-grid">
            {c.items.map((p) => (
              <TarjetaProducto producto={p} tasa={info.rate} client:visible />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <Beneficios beneficios={beneficios} />

  <section class="section section--blue">
    <div class="container">
      <h2 class="h2 text-balance" style="margin-bottom:8px">Cómo trabajamos</h2>
      <p class="lead" style="max-width:52ch">
        Primero entendemos qué necesitás, después ponemos precio. Lo mismo para una pieza suelta que para una tanda.
      </p>
      <Pasos pasos={pasos} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="h2" style="margin-bottom:24px">Preguntas frecuentes</h2>
      <Faq preguntas={preguntas} />
    </div>
  </section>

  <CtaCotizar
    titulo="¿Tenés una idea? La convertimos en producto."
    texto="Contanos qué necesitás y te respondemos con un precio."
    boton="Cotizar ahora"
  />
</Base>
