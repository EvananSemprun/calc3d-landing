---
/**
 * Servicio de impresión 3D. Página ESTÁTICA: todo el contenido está en el HTML del
 * build y no depende de la API (el WhatsApp de los CTA se completa en el navegador,
 * ver WhatsappCotizar en Base).
 *
 * Se habla de para qué sirve cada pieza, no de siglas: el cliente no es experto y el
 * experto pregunta por privado. Los usos son los REALES del taller — no una lista
 * genérica copiada de otro sitio. Si mañana se suma uno, se agrega acá.
 */
import Base from '../../layouts/Base.astro';
import LinkButton from '../../components/LinkButton.astro';
import CtaCotizar from '../../components/CtaCotizar.astro';
import impresora from '../../assets/brand/impresora-3d.png';

const usosPorPieza = [
  {
    nombre: 'Decoración y detalle fino',
    texto:
      'Buen acabado y mucho detalle. Para llaveros, decoración, figuras y prototipos que no van a estar al sol.',
  },
  {
    nombre: 'Uso diario e intemperie',
    texto:
      'Resiste el calor, la humedad y el uso diario. Para piezas de uso, soportes y cosas que van a la intemperie.',
  },
  { nombre: 'Golpes y repuestos', texto: 'Duro y resistente a golpes. Para repuestos y piezas mecánicas que trabajan.' },
  {
    nombre: 'Flexible, tipo goma',
    texto: 'Para fundas, topes, juntas y todo lo que tenga que doblarse sin romperse.',
  },
];

const usos = [
  {
    titulo: 'Para tu negocio',
    items: [
      'Llaveros y souvenirs con tu logo',
      'Identificadores y señalética',
      'Exhibidores y soportes de mostrador',
      'Regalos corporativos en tanda',
    ],
  },
  {
    titulo: 'Para ti',
    items: [
      'Repuestos de cosas que ya no se consiguen',
      'Organizadores y soportes a medida',
      'Decoración y regalos personalizados',
      'Prototipos de un proyecto propio',
    ],
  },
];
---

<Base
  title="Impresión 3D — Banano Lab"
  description="Impresión 3D por encargo en Venezuela. Piezas desde una unidad, con tu archivo o diseño desde cero. Cotiza por WhatsApp."
  canonical="/impresion-3d/"
>
  <section class="hero hero--sm">
    <div class="container hero-art-grid">
      <div>
        <span class="kicker">El servicio</span>
        <h1 class="h1 text-balance">Impresión 3D por encargo.</h1>
        <p class="lead">
          Desde una pieza suelta hasta una tanda para tu negocio. Producimos bajo pedido: no hay stock que se venza ni
          mínimos absurdos.
        </p>
        <div class="hero-actions">
          <LinkButton href="#" cotizar>Cotizar una pieza</LinkButton>
          <LinkButton href="/tienda/" variant="outline">Ver lo que ya hacemos</LinkButton>
        </div>
      </div>
      <img
        class="hero-art"
        src={impresora.src}
        width={impresora.width}
        height={impresora.height}
        alt=""
        loading="eager"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="h2 mb-2">Según para qué sea la pieza</h2>
      <p class="lead mb-7">
        Cada pieza pide algo distinto. Cuéntanos para qué es y nosotros resolvemos cómo hacerla.
      </p>
      <div class="grid grid-3">
        {
          usosPorPieza.map((m) => (
            <article class="card pad">
              <h3 class="h3">{m.nombre}</h3>
              <p class="dim">{m.texto}</p>
            </article>
          ))
        }
        <article class="card pad card--soft">
          <h3 class="h3">¿Otro?</h3>
          <p class="dim">Si tu pieza necesita algo que no está en esta lista, pregúntanos. Se consigue casi todo.</p>
        </article>
      </div>
    </div>
  </section>

  {/*
    Contenido PROPIO de esta página (es la que posiciona en buscadores): qué decisiones
    mueven el precio. NO repite los cinco pasos del proceso, que viven en un solo lugar
    —la portada— y acá entran como enlace al final, de complemento.
  */}
  <section class="section section--blue" aria-labelledby="precio-titulo">
    <div class="container">
      <h2 class="h2 text-balance mb-2" id="precio-titulo">Qué define el precio de tu pieza</h2>
      <p class="lead">
        Aquí se decide todo lo que cambia el precio: el tamaño de la pieza, la cantidad que necesitas, el color y el
        acabado con el que la quieres.
      </p>
      <p class="dim max-w-[56ch] mt-[14px]">
        Lo que no vas a tener que elegir es el nombre de un material. Qué plástico entra en tu pieza lo resolvemos
        nosotros según para qué la vas a usar, y no cambia lo que pagas.
      </p>
      <p class="dim max-w-[56ch] mt-[14px]">
        Con esas cuatro cosas te damos un precio cerrado antes de que arranque la impresora: no se mueve a mitad del
        trabajo.
      </p>
      <div class="acciones mt-5">
        <LinkButton href="/#como-trabajamos" variant="outline">Ver cómo trabajamos</LinkButton>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="h2 mb-6">Qué se puede hacer</h2>
      <div class="grid grid-2">
        {
          usos.map((u) => (
            <article class="card pad">
              <h3 class="h3">{u.titulo}</h3>
              <ul class="ticks">
                {u.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaCotizar
    titulo="Cuéntanos qué necesitas imprimir."
    texto="Con las medidas y la cantidad ya podemos darte un precio."
    boton="Cotizar una pieza"
  />
</Base>
