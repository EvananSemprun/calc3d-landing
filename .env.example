# ==========================================================================
#  CÓMO CORRER ESTE PROYECTO — Tienda pública (puerto 5182)
# ==========================================================================
#  En PowerShell, desde la carpeta que contiene los repos:
#
#    cd calc3d-landing
#    pnpm dev
#
#  Abrí http://localhost:5182. Los productos salen de la API: levantala antes
#  (cd calc3d-api, luego pnpm dev).
#  ⚠️ En PowerShell 5.1 no existe `&&`: los comandos van en líneas separadas.
# ==========================================================================

# URL de la API pública de Calc3D (sin barra final).
# En desarrollo apunta a la API local; en producción, al dominio de la API.
VITE_API_URL="http://localhost:3001/api"

# Dominio publico del sitio, SIN barra final (ej. https://bananolab.com).
# Se hornea en el build: con ella se generan sitemap.xml y la linea Sitemap del
# robots.txt. Si falta, el build avisa y NO emite el sitemap — uno con el dominio
# equivocado es peor que no tenerlo.
VITE_SITE_URL=""
